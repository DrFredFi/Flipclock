<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Flipclock.App.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,18,0,6" />
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        </Style>
        <Style TargetType="Slider" BasedOn="{StaticResource DefaultSliderStyle}">
            <Setter Property="Margin" Value="0,2,0,4" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
          BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="20,14,12,6">
            <TextBlock Text="{x:Bind L.Settings}" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button HorizontalAlignment="Right" Click="OnCloseClick" ToolTipService.ToolTip="{x:Bind L.Close}" AutomationProperties.Name="{x:Bind L.Close}"
                    Background="Transparent" BorderThickness="0" Padding="8">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="20,0,20,0">
            <StackPanel Padding="0,0,0,20">

                <!-- Clock -->
                <TextBlock Text="{x:Bind L.SectionClock}" Style="{StaticResource SectionHeader}" />
                <Slider x:Name="SecondsScaleSlider" Header="{x:Bind L.SecondsSize}" Minimum="30" Maximum="100" StepFrequency="1" ValueChanged="OnSliderChanged" />
                <Slider x:Name="MarginSlider" Header="{x:Bind L.Margin}" Minimum="0" Maximum="500" StepFrequency="5" ValueChanged="OnSliderChanged" />

                <!-- Colors -->
                <TextBlock Text="{x:Bind L.SectionColors}" Style="{StaticResource SectionHeader}" />
                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <DropDownButton x:Name="TileColorButton" HorizontalAlignment="Stretch" Tag="tile" />
                    <DropDownButton x:Name="DigitColorButton" Grid.Column="1" HorizontalAlignment="Stretch" Tag="digit" />
                    <DropDownButton x:Name="DateColorButton" Grid.Row="1" HorizontalAlignment="Stretch" Tag="date" />
                    <DropDownButton x:Name="BackgroundColorButton" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Tag="background" />
                </Grid>

                <!-- Fonts -->
                <TextBlock Text="{x:Bind L.SectionFonts}" Style="{StaticResource SectionHeader}" />
                <ComboBox x:Name="DigitFontBox" Header="{x:Bind L.DigitFont}" HorizontalAlignment="Stretch" SelectionChanged="OnComboChanged" />
                <ComboBox x:Name="DigitWeightBox" Header="{x:Bind L.Weight}" HorizontalAlignment="Stretch" Margin="0,6,0,0" SelectionChanged="OnComboChanged" />
                <ComboBox x:Name="DateFontBox" Header="{x:Bind L.DateFont}" HorizontalAlignment="Stretch" Margin="0,12,0,0" SelectionChanged="OnComboChanged" />
                <ComboBox x:Name="DateWeightBox" Header="{x:Bind L.Weight}" HorizontalAlignment="Stretch" Margin="0,6,0,0" SelectionChanged="OnComboChanged" />

                <!-- Lighting -->
                <TextBlock Text="{x:Bind L.SectionLighting}" Style="{StaticResource SectionHeader}" />
                <Slider x:Name="LightAngleSlider" Header="{x:Bind L.LightAngle}" Minimum="0" Maximum="360" StepFrequency="1" ValueChanged="OnSliderChanged" />
                <Slider x:Name="LightIntensitySlider" Header="{x:Bind L.LightIntensity}" Minimum="20" Maximum="200" StepFrequency="1" ValueChanged="OnSliderChanged" />
                <Slider x:Name="GlossinessSlider" Header="{x:Bind L.Finish}" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="OnSliderChanged" />
                <Grid Margin="0,-6,0,0">
                    <TextBlock Text="{x:Bind L.Matte}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <TextBlock Text="{x:Bind L.Glossy}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" HorizontalAlignment="Right" />
                </Grid>

                <!-- Animation -->
                <TextBlock Text="{x:Bind L.SectionAnimation}" Style="{StaticResource SectionHeader}" />
                <Slider x:Name="FlipDurationSlider" Header="{x:Bind L.FlipDuration}" Minimum="150" Maximum="1000" StepFrequency="10" ValueChanged="OnSliderChanged" />
                <Slider x:Name="CascadeDelaySlider" Header="{x:Bind L.CascadeDelay}" Minimum="0" Maximum="200" StepFrequency="5" ValueChanged="OnSliderChanged" />
                <Slider x:Name="BounceSlider" Header="{x:Bind L.Bounce}" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="OnSliderChanged" />
                <Button Content="{x:Bind L.TestFlip}" Click="OnTestFlipClick" Margin="0,4,0,0" />

                <!-- Sound -->
                <TextBlock Text="{x:Bind L.SectionSound}" Style="{StaticResource SectionHeader}" />
                <ToggleSwitch x:Name="SoundEnabledSwitch" Header="{x:Bind L.TickSound}" Toggled="OnToggled" />
                <Slider x:Name="VolumeSlider" Header="{x:Bind L.Volume}" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="OnSliderChanged" />
                <TextBlock Text="{x:Bind L.SoundFile}" Margin="0,4,0,4" />
                <TextBlock x:Name="SoundFileName" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                    <Button Content="{x:Bind L.Browse}" Click="OnBrowseSoundClick" />
                    <Button Content="{x:Bind L.Clear}" Click="OnClearSoundClick" />
                    <Button Content="{x:Bind L.TestTick}" Click="OnTestTickClick" />
                </StackPanel>

                <!-- Background -->
                <TextBlock Text="{x:Bind L.SectionBackground}" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="{x:Bind L.BackgroundImage}" Margin="0,0,0,4" />
                <TextBlock x:Name="BackgroundFileName" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                    <Button Content="{x:Bind L.Browse}" Click="OnBrowseImageClick" />
                    <Button Content="{x:Bind L.Clear}" Click="OnClearImageClick" />
                </StackPanel>
                <Slider x:Name="BackgroundDimSlider" Header="{x:Bind L.Dim}" Minimum="0" Maximum="90" StepFrequency="1" ValueChanged="OnSliderChanged" Margin="0,8,0,0" />

                <!-- Date -->
                <TextBlock Text="{x:Bind L.SectionDate}" Style="{StaticResource SectionHeader}" />
                <ToggleSwitch x:Name="DateVisibleSwitch" Header="{x:Bind L.ShowDate}" Toggled="OnToggled" />
                <ComboBox x:Name="DatePositionBox" Header="{x:Bind L.Position}" HorizontalAlignment="Stretch" SelectionChanged="OnComboChanged" />
                <Slider x:Name="DateSizeSlider" Header="{x:Bind L.DateSize}" Minimum="50" Maximum="300" StepFrequency="5" ValueChanged="OnSliderChanged" Margin="0,8,0,0" />
                <ComboBox x:Name="DateLanguageBox" Header="{x:Bind L.DateLanguage}" HorizontalAlignment="Stretch" SelectionChanged="OnComboChanged" />

                <!-- Window -->
                <TextBlock Text="{x:Bind L.SectionWindow}" Style="{StaticResource SectionHeader}" />
                <ToggleSwitch x:Name="AlwaysOnTopSwitch" Header="{x:Bind L.AlwaysOnTop}" Toggled="OnToggled" />
                <ToggleSwitch x:Name="BorderlessSwitch" Header="{x:Bind L.Borderless}" Toggled="OnToggled" />
                <ToggleSwitch x:Name="FullscreenSwitch" Header="{x:Bind L.Fullscreen}" Toggled="OnToggled" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="20,10,20,14" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Button Content="{x:Bind L.ResetDefaults}" HorizontalAlignment="Stretch" Click="OnResetClick" />
        </Border>
    </Grid>
</UserControl>
