<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Flipclock.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Flipclock.App"
    Title="Flipclock">

    <Grid x:Name="Root" Background="Black" PointerMoved="OnPointerActivity" PointerPressed="OnRootPointerPressed">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F11" Invoked="OnFullscreenAccelerator" />
            <KeyboardAccelerator Key="B" Modifiers="Control" Invoked="OnBorderlessAccelerator" />
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
        </Grid.KeyboardAccelerators>

        <SwapChainPanel x:Name="ClockPanel" SizeChanged="OnPanelSizeChanged" CompositionScaleChanged="OnCompositionScaleChanged" />

        <!-- Transparent layer that receives clicks over the clock (drag / double-click). -->
        <Grid x:Name="InputLayer" Background="Transparent" DoubleTapped="OnInputDoubleTapped" />

        <TextBlock x:Name="DateText" IsHitTestVisible="False" VerticalAlignment="Top" TextWrapping="NoWrap" />

        <InfoBar x:Name="WarningBar" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="12" MaxWidth="640"
                 Severity="Warning" IsOpen="False" />

        <Button x:Name="CogButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                Width="44" Height="44" Padding="0" CornerRadius="22" Click="OnCogClick"
                Background="#40000000" BorderThickness="0"
                AutomationProperties.Name="{x:Bind L.Settings}" ToolTipService.ToolTip="{x:Bind L.Settings}">
            <FontIcon Glyph="&#xE713;" FontSize="18" Foreground="White" />
            <Button.OpacityTransition>
                <ScalarTransition Duration="0:0:0.4" />
            </Button.OpacityTransition>
        </Button>

        <local:SettingsPanel x:Name="Settings" Width="360" HorizontalAlignment="Right" Visibility="Collapsed">
            <local:SettingsPanel.RenderTransform>
                <TranslateTransform x:Name="SettingsShift" X="360" />
            </local:SettingsPanel.RenderTransform>
        </local:SettingsPanel>
    </Grid>
</Window>
